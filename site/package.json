{
  "name": "frank-pinsent-pottery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply frank-db --local",
    "db:seed:local": "wrangler d1 execute frank-db --local --file=seed/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply frank-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true,
    "esbuild@0.28.2": true
  }
}
